NEXT_PUBLIC_BASE_URL=https://api.example.com
NEXTAUTH_URL=https://app.example.com
AUTH_SECRET=replace-with-a-random-secret
AUTH_ISSUER_URL=https://zitadel.example.com
AUTH_CLIENT_ID=replace-with-zitadel-client-id
AUTH_CLIENT_SECRET=replace-with-zitadel-client-secret
AUTH_POST_LOGOUT_REDIRECT_URI=https://app.example.com
AUTH_SCOPES=openid email profile offline_access urn:zitadel:iam:org:project:id:replace-with-antirecurso-project-id:aud
# Optional override for the AntiRecurso Project's ZITADEL role claim.
AUTH_ROLE_CLAIM=urn:zitadel:iam:org:project:roles
AUTH_DEBUG=false
