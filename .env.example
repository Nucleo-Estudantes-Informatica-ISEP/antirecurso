# Local development defaults. Coolify derives the public frontend URL from
# SERVICE_URL_WEB_3000 and generates AUTH_SECRET automatically when unset.
NEXT_PUBLIC_BASE_URL=http://localhost:3333
NEXT_PUBLIC_PROTECTED_API_BASE_URL=http://localhost:3000/api/backend
NEXTAUTH_URL=http://localhost:3000
AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

AUTH_SECRET=replace-with-a-random-secret
AUTH_ISSUER_URL=https://auth.dev.nei-isep.org
AUTH_CLIENT_ID=replace-with-antirecurso-web-client-id
AUTH_CLIENT_SECRET=replace-with-antirecurso-web-client-secret
AUTH_PROJECT_ID=replace-with-antirecurso-project-id
AUTH_GLOBAL_PROJECT_ID=replace-with-nei-global-project-id

# The frontend requests the AntiRecurso API audience plus the NEI Global
# audience so the shared `admin` role is exposed under the project-specific claim.
AUTH_SCOPES=openid email profile offline_access urn:zitadel:iam:org:projects:roles urn:zitadel:iam:org:project:id:replace-with-antirecurso-project-id:aud urn:zitadel:iam:org:project:id:replace-with-nei-global-project-id:aud
AUTH_ROLE_CLAIM=urn:zitadel:iam:org:project:replace-with-nei-global-project-id:roles
AUTH_DEBUG=false
